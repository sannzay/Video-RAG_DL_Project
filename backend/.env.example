# Copy this file to backend/.env and fill in the two required keys below.
# backend/.env is gitignored — never commit real keys.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# OpenAI key — used for Whisper audio transcription and
# text-embedding-3-small (all semantic-search indexes).
OPENAI_API_KEY=your_openai_api_key_here

# API key for the chat + vision model provider.
# Used for the chat answer (Meta Llama 3.3 70B Instruct) and the frame
# vision captions that drive the description + domain indexes
# (Google Gemini 2.0 Flash). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# Optional / legacy
# -----------------------------------------------------------------------------

# Legacy — no longer used by active code, accepted for .env backward-compat.
# Leave blank or omit.
GROQ_API_KEY=
GOOGLE_API_KEY=
